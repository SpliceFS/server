#!/bin/sh
# A container has no running OpenRC; the files are installed and there is nothing to start.
if [ -e /run/openrc/softlevel ]; then
    rc-update add splicefsd default
    # The server needs no configuration: installed means running.
    rc-service splicefsd start || echo "splicefsd did not start; see /var/log/splicefsd.log" >&2
fi
exit 0
