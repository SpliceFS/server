#!/bin/sh
# Runs after the package's files are in place. $2 is the version that was installed
# before, and is empty on a first install.
set -e

case "$1" in
    configure)
        # The server runs as its own user so that a bug in it has no more rights than
        # reading what that user was given.
        if ! getent passwd splicefs >/dev/null; then
            useradd --system --user-group --no-create-home --home-dir /nonexistent \
                --shell /usr/sbin/nologin splicefs
        fi
        # A container or a chroot has no running systemd. The files are installed and
        # there is nothing to start.
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
            if [ -z "$2" ]; then
                systemctl enable splicefsd.service
                systemctl start splicefsd.service ||
                    echo "splicefsd did not start; see: journalctl -u splicefsd" >&2
            else
                # A broken configuration must not turn an upgrade into a failed install.
                systemctl try-restart splicefsd.service ||
                    echo "splicefsd did not restart; see: journalctl -u splicefsd" >&2
            fi
        fi
        ;;
esac
